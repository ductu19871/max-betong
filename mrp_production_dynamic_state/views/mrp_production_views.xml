<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- MRP Production Form View Inherit -->
    <record model="ir.ui.view" id="mrp_production_view_form_inherit">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="stage_id" 
                       options="{'no_create': True, 'no_create_edit': True}"
                       widget="statusbar"
                       domain="[('active', '=', True)]"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <!-- MRP Production Tree View Inherit -->
    <record model="ir.ui.view" id="mrp_production_view_tree_inherit">
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="stage_id" optional="show" string="Stage"/>
            </xpath>
            <xpath expr="//field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>

