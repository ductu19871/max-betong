<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="max_betong_dashboard_analytic.ReturnVolumeChart">
        <div class="chart-card chart-row-item">
            <div class="chart-header">
                <h3 class="chart-title"><t t-esc="t('Return Volume')"/></h3>
            </div>
            <div class="chart-body">
                <t t-if="hasData">
                    <canvas t-ref="canvas"/>
                    <div class="chart-legend">
                        <div class="legend-item">
                            <span class="legend-color" style="background-color: #1976D2;"/>
                            <span><t t-esc="t('Remix')"/></span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-color" style="background-color: #FB8C00;"/>
                            <span><t t-esc="t('Dump')"/></span>
                        </div>
                        <div class="legend-item">
                            <span class="legend-color" style="background-color: #43A047;"/>
                            <span><t t-esc="t('Swap')"/></span>
                        </div>
                    </div>
                </t>
                <t t-if="!hasData" class="chart-no-data">
                    <div class="no-data-message">
                        <i class="fa fa-info-circle"/>
                        <span><t t-esc="t('No data available')"/></span>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>

