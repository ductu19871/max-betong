<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="max_betong_dashboard_analytic.OnTimeDeliveryChart">
        <div class="chart-card chart-row-item on-time-delivery">
            <div class="chart-header">
                <div class="chart-title-wrapper">
                    <h3 class="chart-title">On Time Delivery</h3>
                </div>
                <div class="chart-actions">
                </div>
            </div>
            <div class="chart-body">
                <t t-if="hasData">
                    <div class="pie-chart-container" style="justify-content: center;">
                        <div class="pie-chart-main" style="align-items: center;">
                            <div class="pie-chart-canvas-wrapper">
                                <canvas t-ref="canvas"/>
                                <div class="chart-center-value green">
                                    <t t-esc="chartValue || 0"/>%
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
                <t t-if="!hasData">
                    <div class="chart-no-data">
                        <div class="no-data-message">
                            <i class="fa fa-info-circle"/>
                            <span>No Data</span>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
