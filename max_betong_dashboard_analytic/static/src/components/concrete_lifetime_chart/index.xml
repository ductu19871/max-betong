<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="max_betong_dashboard_analytic.ConcreteLifetimeChart">
        <div class="chart-card chart-medium">
            <div class="chart-header">
                <div class="chart-title-wrapper">
                    <h3 class="chart-title">Concrete Lifetime</h3>
                    <button t-if="debugEnabled &amp;&amp; props.debugData"
                            class="btn-debug-chart"
                            t-on-click="props.onDebugClick"
                            t-att-title="'View ' + (props.debugData.count || 0) + ' records'">
                        <i class="fa fa-list"></i>
                        <t t-esc="props.debugData.count || 0"/>
                    </button>
                </div>
                <div class="chart-actions">
                    <p class="chart-average">
                        Average: <span class="chart-average-value"><t t-esc="formatAverage(chartData.average)"/> min/Vehicle</span>
                    </p>
                </div>
            </div>
            <div class="chart-body">
                <t t-if="hasData">
                    <canvas t-ref="canvas"/>
                </t>
                <t t-if="!hasData">
                    <div class="chart-no-data">
                        <div class="no-data-message">
                            <i class="fa fa-info-circle"/>
                            <span>No Data</span>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
