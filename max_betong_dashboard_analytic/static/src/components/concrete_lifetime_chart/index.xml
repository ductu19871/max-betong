<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="max_betong_dashboard_analytic.ConcreteLifetimeChart">
        <div class="chart-card chart-medium">
            <div class="chart-header">
                <h3 class="chart-title"><t t-esc="t('Concrete Lifetime')"/></h3>
                <div class="chart-actions">
                    <p class="chart-average">
                        <t t-esc="t('Average')"/>: 
                        <span class="chart-average-value">
                            <t t-esc="chartData.average || 0"/> <t t-esc="t('minutes/Vehicle')"/>
                        </span>
                    </p>
                </div>
            </div>
            <div class="chart-body">
                <t t-if="hasData">
                    <canvas t-ref="canvas"/>
                </t>
                <t t-if="!hasData" class="chart-no-data">
                    <div class="no-data-message">
                        <i class="fa fa-info-circle"/>
                        <span><t t-esc="t('No data available')"/></span>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>

