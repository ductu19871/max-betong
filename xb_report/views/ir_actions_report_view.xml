<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="act_report_xml_view_form" model="ir.ui.view">
        <field name="name">ir.actions.report.form</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view"/>
        <field name="arch" type="xml">
            <field name="print_report_name" position="after">
                <field name="execution_mode"/>
            </field>
            <xpath expr="//field[@name='report_type']" position="after">
                <field name="fonts" invisible="1"/> <!-- Current support for Report Fill PDF -->
                <field name="password_name" invisible="report_type != 'qweb-pdf'"/>
            </xpath>
        </field>
    </record>
    
    <record id="act_report_xml_view_tree" model="ir.ui.view">
        <field name="name">ir.actions.report.tree</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view_tree"/>
        <field name="arch" type="xml">
            <field name="attachment" position="after">
                <field name="execution_mode"/>
            </field>
        </field>
    </record>

</odoo>
