<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_view_form" model="ir.ui.view">
        <field name="name">paper_format_view_form_inherit</field>
        <field name="model">report.paperformat</field>
        <field name="inherit_id" ref="base.paperformat_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='dpi']" position="after">
                <field name="enable_forms"/>
            </xpath>
        </field>
    </record>

</odoo>
