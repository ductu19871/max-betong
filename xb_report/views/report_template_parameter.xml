<odoo>

    <record id="config_template_report_parameter_form_view" model="ir.ui.view">
        <field name="name">report.template.parameter.form</field>
        <field name="model">report.template.parameter</field>
        <field name="arch" type="xml">
            <form>
                <header>
                <button name="action_unlink" string="Remove All" type="object" class="btn-primary"/>
            </header>
                <sheet>
                    <group>
                        <field name="key" required="1"/>
                        <field name="name" required="1"/>
                        <field name="model_filter" invisible="1" />
                        <field name="template_ids" />
                    </group>
                    <notebook>
                        <page string="Description" name="description">
                            <field name="description" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="config_template_report_parameter_tree_view" model="ir.ui.view">
        <field name="name">report.template.parameter.tree</field>
        <field name="model">report.template.parameter</field>
        <field name="arch" type="xml">
            <tree>
                <field name="key" />
                <field name="name" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_config_template_report_parameter">
        <field name="name">Config Template Parameter</field>
        <field name="res_model">report.template.parameter</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'default_model_filter': 'general'}</field>
    </record>
    
</odoo>