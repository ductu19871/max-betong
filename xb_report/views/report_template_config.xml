<odoo>
    
    <record id="config_template_report_form_view" model="ir.ui.view">
        <field name="name">report.template.config.from</field>
        <field name="model">report.template.config</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="catagory"/>
                    <field name="use_python_docx"/>
                    <field name="file_cancel"/>
                    <field name="password"/>
                    <field name="template" required="0" invisible="1" />
                    <field name="filename" invisible="1"/>
                    <field name="file" filename="filename" required="1"/>
                    <field name="name" required="1"/>
                    <field name="key" required="1"/>
                    <field name="output_type" required="1"/>
                    <field name="company_id" required="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="config_template_report_tree_view" model="ir.ui.view">
        <field name="name">report.template.config.tree</field>
        <field name="model">report.template.config</field>
        <field name="arch" type="xml">
            <tree>
                <field name="template" invisible="1"/>
                <field name="name" />
                <field name="key" />
                <field name="company_id"/>
                <field name="catagory"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_config_template_report">
        <field name="name">Config Report Template</field>
        <field name="res_model">report.template.config</field>
        <field name="view_mode">tree,form</field>
    </record>

    
</odoo>