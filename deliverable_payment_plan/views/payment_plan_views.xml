<odoo>
    <record id="view_payment_plan_tree" model="ir.ui.view">
        <field name="name">payment.plan.tree</field>
        <field name="model">deliverable.payment.plan</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="s_curve_mode"/>
                <field name="project_id"/>
                <field name="partner_id" readonly="1"/>
                <field name="type"/>
                <field name="state"/>
                <field name="customer_contract_id"/>
                <field name="subcontractor_contract_id"/>
            </tree>
        </field>
    </record>
    <record id="view_payment_plan_form" model="ir.ui.view">
        <field name="name">payment.plan.form</field>
        <field name="model">deliverable.payment.plan</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate_lines" type="object" string="Generate" class="btn-primary" invisible="state!='draft'"/>
                    <button name="action_generate_sample" type="object" string="Generate Sample" groups="base.group_no_one"
                         class="btn-secondary" invisible="state!='draft'"/>
                    <button name="action_unlink_lines" type="object" string="unlink lines" groups="base.group_no_one"
                         class="btn-secondary" invisible="state!='draft'"/>
                    <!-- BUTTONS -->
                    <button name="action_confirm" type="object" string="Confirm"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <!-- <button name="action_done" type="object" string="Done"
                            class="btn-success"
                            invisible="state != 'confirm'"/> -->
                    <button name="action_cancel" type="object" string="Cancel"
                            class="btn-danger"
                            invisible="state not in ('draft','confirm')"/>
                    <button name="action_reset_draft" type="object" string="Reset to Draft"
                            class="btn-secondary"
                            invisible="state != 'cancel'"/>
                    <!-- STATUS BAR -->
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,confirm"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="type"/>
                            <field name="project_id"/>
                            <field name="from_date"/>
                            <field name="to_date"/>
                            <field name="s_curve_mode" force_save="1"/>
                        </group>
                        <group>
                            <field name="customer_contract_id" required="type == 'customer'" domain="[('is_customer_contract', '=', True), ('contract_project_id', '=', project_id)]" invisible="type != 'customer'"/>
                            <field name="subcontractor_contract_id" required="type == 'subcontract'" 
                                domain="[('is_sub_contract', '=', True), ('contract_project_id', '=', project_id)]" 
                                invisible="type != 'subcontract'"
                                context="{'form_view_ref': 'xb_job_costing_management.view_subcontractor_contract_form'}"/>
                            <field name="partner_id" force_save="1"/>
                            <field name="total_project_amount"/>
                            <field name="currency_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="currency_id" invisible="1"/>
                                    <!-- Tên + Period -->
                                    <field name="name"/>
                                    <field name="from_date"/>
                                    <field name="to_date"/>
                                    <!-- PLAN -->
                                    <field name="plan_percentage"/>
                                    <field name="plan_amount"/>
                                    <field name="plan_percentage_accumulated"/>
                                    <field name="plan_accumulated_amount"/>
                                    <field name="plan_ipc_amount"/>
                                    <field name="plan_accumulated_ipc_amount"/>
                                    <!-- ACTUAL -->
                                    <field name="actual_percentage"/>
                                    <field name="actual_amount"/>
                                    <field name="actual_percentage_accumulated"/>
                                    <field name="actual_accumulated_amount"/>
                                    <field name="actual_ipc_amount"/>
                                    <field name="actual_accumulated_ipc_amount"/>
                                    <field name="actual_paid_amount"/>
                                    <field name="actual_accumulated_paid_amount"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
 
    <record id="action_payment_plan" model="ir.actions.act_window">
        <field name="name">Payment Plan</field>
        <field name="res_model">deliverable.payment.plan</field>
        <field name="view_mode">tree,form</field>
    </record>
    <record id="view_payment_plan_line_graph" model="ir.ui.view">
        <field name="name">payment.plan.line.graph</field>
        <field name="model">deliverable.payment.plan.line</field>
        <field name="arch" type="xml">
            <graph string="S-Curve" type="line">
                <field name="from_date" interval="month"/>
                <field name="plan_accumulated_amount" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="view_payment_plan_line_search" model="ir.ui.view">
        <field name="name">payment.plan.line.search</field>
        <field name="model">deliverable.payment.plan.line</field>
        <field name="arch" type="xml">
            <search>
                <!-- Basic -->
                <field name="plan_id"/>
                <!-- Filters -->
                <filter name="filter_customer" string="Customer" domain="[('plan_id.type','=','customer')]"/>
                <filter name="filter_subcontract" string="Subcontract" domain="[('plan_id.type','=','subcontract')]"/>
                <!-- Date -->
                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter name="group_plan" string="Plan" context="{'group_by':'plan_id'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="action_payment_plan_line" model="ir.actions.act_window">
        <field name="name">Payment Plan Line</field>
        <field name="res_model">deliverable.payment.plan.line</field>
        <field name="view_mode">graph</field>
    </record>

       
    <menuitem id="menu_contruction_partner" 
        name="Partner"
        parent="odoo_job_costing_management.menu_job_managmt"
        action="max_betong_output_dashboard.action_output_dashboard"
         />
    
    <!-- <menuitem id="menu_payment_plan_dasboard"
        name="Báo cáo Sản Lượng Kế Hoạch &amp; Thực Tế Của Chủ Đầu Tư"
        parent="deliverable_payment_plan.menu_contruction_partner"
        action="max_betong_output_dashboard.action_output_dashboard"
        sequence="20"
          />

    <menuitem 
        id="menu_output_dashboard_subcontract"
        name="Báo cáo Sản Lượng Kế Hoạch &amp; Thực Tế Của Nhà Thầu"
        action="max_betong_output_dashboard.action_output_dashboard_subcontract"
        parent="deliverable_payment_plan.menu_contruction_partner"
        sequence="20"
    /> -->
    
    <menuitem id="menu_payment_plan"
          name="Payment Plan"
          parent="menu_contruction_partner"
          action="action_payment_plan"
          sequence="10"
          />

</odoo>