<odoo>
    <record id="view_company_form_scurve" model="ir.ui.view">
        <field name="name">res.company.form.scurve</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="S-curve Setting" name="scurve_setting">
                    <group string="S-CURVE CONFIGURATION">
                        <field name="s_curve_mode"/>
                        <field name="chart_amount_unit"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>