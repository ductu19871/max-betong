<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="max_betong_output_dashboard.Dashboard" owl="1">
        <div class="o_action o_view_controller max-betong-dashboard-container">
            <t t-if="state.loading">
                <div class="text-center mt-5">
                    <i class="fa fa-spinner fa-spin fa-3x"/>
                    <p>Loading Dashboard...</p>
                </div>
            </t>
            <t t-else="">
                <div class="dashboard-header text-center mb-4">
                    <h2 class="text-uppercase font-weight-bold">BÁO CÁO SẢN LƯỢNG KẾ HOẠCH &amp; THỰC TẾ</h2>
                    <p class="text-muted">Dashboard theo dõi tiến độ và thanh toán hợp đồng xây dựng</p>
                </div>

                <!-- Filters -->
                <div class="dashboard-filters card mb-4 p-3 shadow-sm border-0 rounded-lg">
                    <div class="row">
                        <div class="col-md-3"  t-if="context.type_ == 'customer'">
                            <label class="form-label text-muted small">Chủ đầu tư</label>
                            <Many2XAutocomplete
                                resModel="'res.partner'"
                                update="(records) => this.onFilterUpdate('customer_partner_id', records)"
                                value="state.filters.customer_partner_id"
                                fieldString="'name'"
                                activeActions="{}"
                                getDomain.bind="getDomain"
                                noSearchMore="true"
                            />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label text-muted small">Dự án</label>
                            <Many2XAutocomplete
                                resModel="'project.project'"
                                update="(records) => this.onFilterUpdate('project_id', records)"
                                value="state.filters.project_id"
                                fieldString="'name'"
                                activeActions="{}"
                                getDomain="() => this.getDomain('project_id')"   
                                noSearchMore="true"
                            />
                        </div>
                        <div class="col-md-3" t-if="context.type_ == 'subcontract'">
                            <label class="form-label text-muted small">Nhà thầu</label>
                            <Many2XAutocomplete
                                resModel="'res.partner'"
                                update="(records) => this.onFilterUpdate('subcontractor_partner_id', records)"
                                value="state.filters.subcontractor_partner_id"
                                fieldString="'name'"
                                activeActions="{}"
                                getDomain.bind="getDomain"
                                noSearchMore="true"
                            />
                        </div>
                            <div class="col-md-3" t-if="context.type_ == 'customer'">
                                <label class="form-label text-muted small">Hợp đồng</label>
                                <Many2XAutocomplete
                                    resModel="'sale.order'"
                                    update="(records) => this.onFilterUpdate('customer_contract_ids', records)"
                                    value="state.filters.customer_contract_ids"
                                    fieldString="'name'"
                                    activeActions="{}"
                                    getDomain="() => this.getDomain('customer_contract_ids')"   
                                    noSearchMore="true"
                                />
                            </div>
                        <div class="col-md-3" t-if="context.type_ == 'subcontract'">
                            <label class="form-label text-muted small">Hợp đồng BB'</label>
                            <Many2XAutocomplete
                                resModel="'purchase.order'"
                                update="(records) => this.onFilterUpdate('subcontractor_contract_ids', records)"
                                value="state.filters.subcontractor_contract_ids"
                                fieldString="'name'"
                                activeActions="{}"
                                getDomain="() => this.getDomain('subcontractor_contract_ids')"   
                                noSearchMore="true"
                            />
                        </div>
                    </div>
                </div>

                <t t-if="state.data">
                    <!-- Cards Info -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card h-100 p-3 shadow-sm border-0 rounded-lg">
                                <span class="text-muted small"><i class="fa fa-file-text-o"/> Giá trị hợp đồng</span>
                                <h4 class="font-weight-bold mt-2"><t t-esc="state.data.contract_info.value"/></h4>
                                <span class="badge text-danger mt-2 rounded-pill bg-light border border-danger">
                                    <i class="fa fa-arrow-down"/> Chậm tiến độ <t t-esc="state.data.contract_info.delayed_value"/>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card h-100 p-3 shadow-sm border-0 rounded-lg">
                                <span class="text-muted small"><i class="fa fa-folder-o"/> Tên hợp đồng</span>
                                <h5 class="mt-2"><t t-esc="state.data.contract_info.name"/></h5>
                                <span class="badge text-warning mt-2 rounded-pill bg-light border border-warning">
                                    <i class="fa fa-exclamation-triangle"/> Chậm tiến độ thanh toán <t t-esc="state.data.contract_info.delayed_payment"/>
                                </span>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card h-100 p-3 shadow-sm border-0 rounded-lg">
                                <span class="text-muted small"><i class="fa fa-clock-o"/> Thời gian hợp đồng</span>
                                <h5 class="mt-2"><t t-esc="state.data.contract_info.time"/></h5>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card h-100 p-3 shadow-sm border-0 rounded-lg bg-light">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted small">% Hoàn thành kế hoạch</span>
                                    <span class="text-primary font-weight-bold"><t t-esc="state.data.contract_info.plan_percent"/></span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted small">% hoàn thành thực tế</span>
                                    <span class="text-success font-weight-bold"><t t-esc="state.data.contract_info.actual_percent"/></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Lũy kế Tổng Hợp Row -->
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="card text-center p-3 shadow-sm border-0 border-top border-primary rounded-lg border-3">
                                <span class="text-muted small"><i class="fa fa-circle text-primary"/> Sản lượng kế hoạch lũy kế</span>
                                <h4 class="font-weight-bold mt-2"><t t-esc="state.data.summary.plan_vol"/></h4>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center p-3 shadow-sm border-0 border-top border-success rounded-lg border-3">
                                <span class="text-muted small"><i class="fa fa-circle text-success"/> Sản lượng thực tế lũy kế</span>
                                <h4 class="font-weight-bold mt-2"><t t-esc="state.data.summary.actual_vol"/></h4>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center p-3 shadow-sm border-0 border-top border-warning rounded-lg border-3">
                                <span class="text-muted small"><i class="fa fa-circle text-warning"/> Thanh toán kế hoạch lũy kế</span>
                                <h4 class="font-weight-bold mt-2"><t t-esc="state.data.summary.plan_pay"/></h4>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center p-3 shadow-sm border-0 border-top border-danger rounded-lg border-3">
                                <span class="text-muted small"><i class="fa fa-circle text-danger"/> Thanh toán thực tế lũy kế</span>
                                <h4 class="font-weight-bold mt-2"><t t-esc="state.data.summary.actual_pay"/></h4>
                            </div>
                        </div>
                    </div>

                    <!-- Data Table -->
                    <div class="card mb-4 shadow-sm border-0 rounded-lg">
                        <div class="card-header bg-white border-0 pt-4 pb-2">
                            <h5 class="font-weight-bold text-uppercase m-0">Kế Hoạch Sản Lượng - Giải Ngân VS Thực Tế</h5>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover table-borderless table-striped text-center small mb-0">
                                    <thead class="bg-light text-muted">
                                        <tr>
                                            <t t-foreach="state.data.table_columns" t-as="col" t-key="col_index">
                                                <th class="py-3"><t t-esc="col"/></th>
                                            </t>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="state.data.table_data" t-as="row" t-key="row_index">
                                            <tr>
                                                <t t-foreach="row" t-as="cell" t-key="cell_index">
                                                    <td t-att-class="cell_index == 0 ? 'text-start text-muted font-weight-bold' : ''">
                                                        <t t-esc="cell"/>
                                                    </td>
                                                </t>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <!-- Chart -->
                    <div class="card shadow-sm border-0 rounded-lg mb-5">
                        <div class="card-header bg-white border-0 pt-4 pb-2">
                            <h5 class="font-weight-bold m-0">Biểu đồ S-Curve tổng hợp</h5>
                        </div>
                        <div class="card-body">
                            <div style="position: relative; height: 350px;">
                                <canvas t-ref="chartCanvas"></canvas>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </div>
    </t>
</templates>
