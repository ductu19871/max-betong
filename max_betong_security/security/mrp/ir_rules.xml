<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="mrp_production_rule_by_station_user" model="ir.rule">
            <field name="name">MRP Production by Station User</field>
            <field name="model_id" ref="mrp.model_mrp_production"/>
            <field name="domain_force">
                [('load_station_id.responsible_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_betong_tram'))]"/>
        </record>

        <record id="concrete_load_rule_by_station_user" model="ir.rule">
            <field name="name">Concrete Load by Station User</field>
            <field name="model_id" ref="max_betong_sale.model_concrete_load"/>
            <field name="domain_force">
                [('load_station_id.responsible_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_betong_tram'))]"/>
        </record>

        <record id="sale_order_rule_by_station_user" model="ir.rule">
            <field name="name">Sale Order by Station User</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="domain_force">
                ['|', ('so_type','!=', 'concrete'), ('concrete_station_id.responsible_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_betong_tram'))]"/>
        </record>

        <record id="fleet_vehicle_rule_by_station_user" model="ir.rule">
            <field name="name">Fleet Vehicle by Station User</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>
            <field name="domain_force">
                [('station_id.responsible_id', '=', user.id)]
            </field>
            <field name="groups" eval="[(4, ref('group_betong_tram'))]"/>
        </record>

        <record id="rule_sales_restricted_concrete_bom" model="ir.rule">
            <field name="name">Read-only for Concrete and BOM types</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="groups" eval="[(4, ref('group_sales_restricted_concrete_bom'))]"/>
            <field name="domain_force">[('so_type', 'not in', ['concrete', 'bom'])]</field>
            <field name="perm_read" eval="False"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

    </data>
</odoo>
