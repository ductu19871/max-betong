<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Category -->
        <record id="module_category_max_betong_base" model="ir.module.category">
            <field name="name">ERP Bê Tông Base</field>
            <field name="description">Phân quyền hệ thống ERP Bê Tông Base</field>
            <field name="sequence">10</field>
        </record>

        <!-- Groups -->
        <record id="group_sale_order_line_read" model="res.groups">
            <field name="name">group_sale_order_line_read</field>
            <field name="category_id" ref="module_category_max_betong_base"/>
        </record>

        <record id="group_sale_order_option_read" model="res.groups">
            <field name="name">Sale Order Option Read</field>
            <field name="category_id" ref="module_category_max_betong_base"/>
        </record>

        <record id="group_stock_picking_read" model="res.groups">
            <field name="name">Stock Picking Read</field>
            <field name="category_id" ref="module_category_max_betong_base"/>
        </record>

        <record id="group_stock_move_read" model="res.groups">
            <field name="name">Stock Move Read</field>
            <field name="category_id" ref="module_category_max_betong_base"/>
        </record>

        <record id="access_read_concrete_pump_sale_order" model="res.groups">
            <field name="name">Access Read Concrete Pump Sale Order</field>
            <field name="category_id" ref="module_category_max_betong_base"/>
            <field name="implied_ids" eval="[
        (4, ref('max_betong_security.group_sale_order_line_read')),
        (4, ref('max_betong_security.group_sale_order_option_read')),
        (4, ref('max_betong_security.group_stock_picking_read')),
        (4, ref('max_betong_security.group_stock_move_read'))
    ]"/>
        </record>

           <record id="group_fleet_vehicle_user_readonly" model="res.groups">
                <field name="name">Vehicle User Readonly</field>
                <field name="category_id" ref="module_category_max_betong_base"/>
                <!-- <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/> -->
                <field name="menu_access" eval="[(5,0,0)]"/>
            </record>

            <record model="ir.rule" id="fleet_vehicle_user_rule">
                <field name="name">Vehicle User: Create, Read, Write</field>
                <field name="model_id" ref="fleet.model_fleet_vehicle"/>
                <field name="domain_force">[(1, '=', 1)]</field>
                <field name="groups" eval="[(4, ref('group_fleet_vehicle_user_readonly'))]"/>
                <field name="perm_read" eval="True"/>
                <field name="perm_write" eval="True"/>
                <field name="perm_create" eval="True"/>
                <field name="perm_unlink" eval="False"/>
            </record>

            <record id="fleet.fleet_vehicles" model="ir.ui.menu">
                <field name="groups_id" eval="[(4, ref('group_fleet_vehicle_user_readonly'))]"/>
            </record>

            <record id="fleet.fleet_vehicle_menu" model="ir.ui.menu">
                <field name="groups_id" eval="[(4, ref('group_fleet_vehicle_user_readonly'))]"/>
            </record>

            <record id="group_fleet_vehicle_state_readonly" model="res.groups">
                <field name="name">Fleet Vehicle State Readonly</field>
                <field name="category_id" ref="module_category_max_betong_base"/>
            </record>

            <record id="group_fleet_vehicle_odometer_readonly" model="res.groups">
                <field name="name">Fleet Vehicle Odometer Readonly</field>
                <field name="category_id" ref="module_category_max_betong_base"/>
            </record>
            
            <record id="group_fleet_vehicle_assignation_log_readonly" model="res.groups">
                <field name="name">Fleet Vehicle Assignation Log Readonly</field>
                <field name="category_id" ref="module_category_max_betong_base"/>
            </record>
            
    </data>
</odoo>
