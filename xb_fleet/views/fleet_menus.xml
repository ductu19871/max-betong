<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Menu Visibility Settings -->
        <record id="fleet.fleet_vehicle_log_contract_menu" model="ir.ui.menu">
            <field name="active" eval="True"/>
        </record>

        <record id="fleet.fleet_services_configuration" model="ir.ui.menu">
            <field name="active" eval="True"/>
        </record>

        <record id="fleet.fleet_vehicle_log_services_menu" model="ir.ui.menu">
            <field name="active" eval="True"/>
            <field name="sequence" eval="10"/>
        </record>

        <record id="fleet.menu_fleet_reporting" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('fleet.fleet_group_manager')), (4, ref('fleet.fleet_group_user'))]"/>
        </record>

        <record id="fleet.menu_fleet_reporting_costs" model="ir.ui.menu">
            <field name="groups_id" eval="[(4, ref('fleet.fleet_group_manager')), (4, ref('fleet.fleet_group_user'))]"/>
        </record>

    </data>
</odoo>