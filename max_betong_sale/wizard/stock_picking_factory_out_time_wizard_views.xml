<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_picking_factory_out_time_wizard_form" model="ir.ui.view">
        <field name="name">stock.picking.factory.out.time.wizard.form</field>
        <field name="model">stock.picking.factory.out.time.wizard</field>
        <field name="arch" type="xml">
            <form string="Update Factory Out Time">
                <group>
                    <field name="factory_out_time"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>