<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_wizard_confirm_fields_form" model="ir.ui.view">
        <field name="name">wizard.confirm.fields.form</field>
        <field name="model">wizard.confirm.fields</field>
        <field name="arch" type="xml">
            <form string="Select Vehicle - Station">
                <group>
                    <field name="vehicle_id" required='1' domain="[('state_concrete','=','available')]"/>
                    <field name="vehicle_station_id" required='1'/>
                </group>

                <footer>
                    <button
                        name="action_confirm"
                        string="Confirm"
                        type="object"
                        class="btn-primary"
                        confirm="Are you sure you've selected the correct information above?"
                    />
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    
    <record id="action_wizard_confirm_fields" model="ir.actions.act_window">
	    <field name="name">Confirm Vehicle - Station</field>
	    <field name="res_model">wizard.confirm.fields</field>
	    <field name="view_mode">form</field>
	    <field name="target">new</field>
	</record>
    
</odoo>