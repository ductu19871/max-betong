<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
    <record id="mrp_production_form_view_inherit_max_betong_sale" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit.max.betong.sale</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
		<field name="priority">9999</field>
        <field name="arch" type="xml">
			<xpath expr="//header" position="inside">
				<button name="action_on_hold" 
			            string="On Hold" 
			            type="object"
			            class="oe_stat_button"
			            invisible="state_concrete not in('loading','loaded','leave','arrived','unloading','return') or mo_type !='concrete'"
			            confirm="Are you sure you want to switch on hold? Switching on hold will not revert to the previous state."/>
				<button string="Update State" 
		        		class="btn btn-primary"
		        		type="action" name="%(max_betong_sale.action_wizard_change_state_ticket)d"
		        		invisible="state_concrete in ('completed','on_hold','dump','remix','cancel') or mo_type !='concrete'"/>
			</xpath>
			<xpath expr="//field[@name='product_id']" position="before">
                <field name="mo_type" invisible="1"/>
            </xpath>
			<xpath expr="//field[@name='state']" position="attributes">
				<attribute name="invisible" add="mo_type == 'concrete'" separator=" or "/>
			</xpath>
			<xpath expr="//field[@name='state']" position="after">
				<field name="state_concrete" widget="statusbar" invisible="mo_type != 'concrete'"/>
			</xpath>
			<xpath expr="//sheet/group" position="before">
				<group name="gr_mo_concrete" invisible="mo_type != 'concrete'">
				</group>
				<div class="dropdown-divider mb-4 mt-2" invisible="mo_type != 'concrete'"/>
			</xpath>
			<xpath expr="//group[@name='gr_mo_concrete']" position="inside">
				<group name="load_info">
					<separator string="Load Info"/>
					<field name="load_id" readonly="state_concrete != 'draft'"/>
					<field name="load_station_id"/>
					<field name="sale_order_id"/>
					<field name="bom_mix_id"/>
					<field name="mix_note"/>
					<field name="delivery_address_id"/>
				</group>
				<group name="vehicle_info">
					<separator string="Vehicle Info"/>
					<field name="vehicle_id" 
						domain="load_station_id and [('station_id', '=', load_station_id), ('state_concrete', '=', 'available')] or [('state_concrete', '=', 'available')]"
						readonly="state_concrete != 'draft' or load_id"
					/>
					<field name="vehicle_station_id"/>
				</group>
			</xpath>
            <xpath expr="//div[@name='bom_div']" position="after">
				<field name="load_station_id" string="Ticket Station" invisible="mo_type != 'concrete'"/>
			</xpath>
			<xpath expr="//field[@name='components_availability']" position="before">
				<field name="eta"/>
            </xpath>
            <xpath expr="//field[@name='production_location_id']" position="after">
				<field name="assigned_datetime"/>
                <field name="loading_datetime"/>
                <field name="loaded_datetime"/>
                <field name="leave_datetime"/>
                <field name="distance_km"/>
            </xpath>
            <div name="button_box" position="inside">
				<button name="action_view_do"
				        type="object"
				        class="oe_stat_button"
				        invisible="do_count == 0"
				        icon="fa-truck">
					<field name="do_count" widget="statinfo" string="Delivery Order"/>
				</button>
			</div>
        </field>
    </record>

    <record id="view_mrp_production_filter_inherit_betong" model="ir.ui.view">
        <field name="name">view_mrp_production_filter_inherit_betong</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
            	<field name="sale_order_id"/>
            	<field name="vehicle_station_id"/>
            	<field name="vehicle_id"/>
            	<field name="eta"/>
            	<field name="delivery_address_id"/>
            	<field name="create_date"/>
            	<field name="create_uid"/>
            	<field name="user_id"/>
            	<filter string="Draft" name="state_draft"
				        domain="[('state','=','draft')]"/>
				
				<filter string="Assigned" name="state_assigned"
				        domain="[('state','=','assigned')]"/>
				
				<filter string="Loading" name="state_loading"
				        domain="[('state','=','loading')]"/>
				
				<filter string="Loaded" name="state_loaded"
				        domain="[('state','=','loaded')]"/>
				
				<filter string="Leave" name="state_leave"
				        domain="[('state','=','leave')]"/>
				
				<filter string="Arrived" name="state_arrived"
				        domain="[('state','=','arrived')]"/>
				
				<filter string="Unloading" name="state_unloading"
				        domain="[('state','=','unloading')]"/>
				
				<filter string="Return" name="state_return"
				        domain="[('state','=','return')]"/>
				
				<filter string="Completed" name="state_completed"
				        domain="[('state','=','completed')]"/>
				
				<filter string="On Hold" name="state_on_hold"
				        domain="[('state','=','on_hold')]"/>
				
				<filter string="Dump" name="state_dump"
				        domain="[('state','=','dump')]"/>
				
				<filter string="Remix &amp; Swapped" name="state_remix"
				        domain="[('state','=','remix')]"/>
				
				<filter string="Cancelled" name="state_cancel"
				        domain="[('state','=','cancel')]"/>
            </xpath>
            <xpath expr="//filter[@name='date']" position="after">
            	<filter string="Sales Order"
            			name="sale_order"
			            context="{'group_by':'sale_order_id'}"/>
			    <filter string="Station"
			    		name="plant"
			            context="{'group_by':'vehicle_station_id'}"/>
			    <filter string="Vehicle"
			    		name="vehicle"
			            context="{'group_by':'vehicle_id'}"/>
			    <filter string="Construction Site"
			    		name="construction"
			            context="{'group_by':'delivery_address_id'}"/>
			    <filter string="ETA"
			    		name="eta"
			            context="{'group_by':'eta'}"/>
            </xpath>
        </field>
    </record>
    
    <record id="mrp_production_tree_view_inherit_max_betong_sale" model="ir.ui.view">
        <field name="name">mrp.production.tree.view.inherit.max.betong.sale</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
            	<field name="eta" optional="show"/>
            	<field name="vehicle_station_id" optional="show"/>
            	<field name="vehicle_id" optional="show"/>
            	<field name="sale_order_id" optional="show"/>
            	<field name="create_date" optional="show"/>
            </xpath>
        </field>
    </record>
    
	<record id="action_concrete_ticket" model="ir.actions.act_window">
		<field name="name">Concrete Tickets</field>
		<field name="res_model">mrp.production</field>
		<field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
		<field name="view_id" eval="False"/>
		<field name="search_view_id" ref="mrp.view_mrp_production_filter"/>
		<field name="context">{'default_mo_type': 'concrete', 'search_default_todo': True, 'default_company_id': allowed_company_ids[0]}</field>
		<field name="domain">[('mo_type', '=', 'concrete')]</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
			No concrete ticket found. Let's create one.
			</p><p>
			Use Concrete Tickets to build finished products while consuming components: i.e. 1 Table = 4 Table Legs + 1 Table Top
			</p>
		</field>
	</record>


    <record id="mrp.mrp_production_action" model="ir.actions.act_window">
		<field name="domain">[('mo_type', '=', 'normal')]</field>
	</record>
</odoo>