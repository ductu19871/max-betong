<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
    <record id="mrp_production_form_view_inherit_max_betong_sale" model="ir.ui.view">
        <field name="name">mrp.production.form.view.inherit.max.betong.sale</field>
        <field name="model">mrp.production</field>
    	<!-- <field name="mode">extension</field> -->
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
		<field name="mode">primary</field>
		<field name="priority">10</field>
        <field name="arch" type="xml">
			<xpath expr="//header" position="inside">
			    <button name="action_on_hold"
			            string="On Hold"
			            type="object"
			            class="oe_stat_button"
			            invisible="state_concrete not in('loading','loaded','leave','arrived','unloading','return') or mo_type !='concrete'"
			            confirm="Are you sure you want to switch on hold? Switching on hold will not revert to the previous state."/>
			   <button string="Update State"
		        		class="btn btn-primary"
		        		type="action" name="%(max_betong_sale.action_wizard_change_state_ticket)d"
		        		invisible="state_concrete in ('completed','on_hold','dump','remix','swap','cancel') or mo_type !='concrete'"/>
				<button name="action_concrete_remix"
		        		string="Remix"
		        		type="object"
		        		class="oe_stat_button"
		        		invisible="state_concrete not in ['on_hold','remix'] or mo_type !='concrete' or on_hold_ticket_id"/>
				<button name="action_concrete_swap"
		        		string="Swap"
		        		type="object"
		        		class="oe_stat_button"
		        		invisible="state_concrete not in ['on_hold','swap'] or mo_type !='concrete' or on_hold_ticket_id"/>
			</xpath>
			<xpath expr="//button[@name='action_cancel']" position="attributes">
				<attribute name="invisible" add="mo_type == 'concrete' and ticket_on_hold_id"  separator=" or "/>
			</xpath>
			<xpath expr="//button[@name='button_scrap']" position="attributes">
				<attribute name="invisible" add="mo_type == 'concrete' and state_concrete != 'on_hold'"  separator=" or "/>
			</xpath>
			<xpath expr="//field[@name='product_id']" position="before">
                <field name="mo_type" invisible="1"/>
				<field name="ticket_on_hold_type" invisible="1"/>
				<field name="on_hold_ticket_type" invisible="1"/>
				<field name="ticket_on_hold_id" invisible="1"/>
				<field name="on_hold_ticket_id" invisible="1"/>
            </xpath>
			<xpath expr="//field[@name='state']" position="attributes">
           		<attribute name="invisible">mo_type == 'concrete'</attribute>
           </xpath>
           <xpath expr="//field[@name='state']" position="after">
           		<field name="state_concrete" widget="statusbar"
           			invisible="mo_type != 'concrete'"/>
           </xpath>
            <xpath expr="//group[1]//group[1]" position="inside">
				<field name="mix_note"/>
                <field name="load_id" invisible='1'/>
                <field name="sale_order_id"/>
                <field name="vehicle_id" readonly="1" force_save="1"/>
                <field name="load_station_id" string="Station"/>
                <field name="delivery_address_id"/>
            </xpath>
            <xpath expr="//field[@name='components_availability']" position="before">
            	<field name="eta"/>
            </xpath>
            <xpath expr="//field[@name='production_location_id']" position="after">
            	<field name="assigned_datetime"/>
                <field name="loading_datetime"/>
                <field name="loaded_datetime"/>
                <field name="leave_datetime"/>
                <field name="distance_km"/>
            </xpath>
			<xpath expr="//field[@name='qty_producing']" position="attributes">
				<attribute name="readonly">mo_type == 'concrete' or state == 'cancel'</attribute>
			</xpath>
            <div name="button_box" position="inside">
				<button name="action_view_do"
				        type="object"
				        class="oe_stat_button"
				        invisible="do_count == 0"
				        icon="fa-truck">
				    <field name="do_count" widget="statinfo" string="Delivery Order"/>
				</button>
				<button name="action_view_on_hold_ticket"
				        type="object"
				        class="oe_stat_button"
				        icon="fa-ticket"
				        invisible="not on_hold_ticket_id">
					Refer to
				</button>
				<button name="action_view_ticket_on_hold"
				        type="object"
				        class="oe_stat_button"
				        icon="fa-ticket"
				        invisible="not ticket_on_hold_id">
					Refer from
				</button>
			</div>

			 <xpath expr="//notebook" position="inside">
				<page name="ticket_notes_page" string="Ticket Notes" invisible="mo_type != 'concrete'">
					<group>
						<field name="ticket_note" widget="text" />
						<field name="on_hold_reason" string="Remix Reason" readonly="1" widget="text" invisible="not on_hold_reason"/>
					</group>
				</page>
			</xpath>
			<xpath expr="//div[@name='bom_div']" position="attributes">
				<attribute name="invisible" add="ticket_on_hold_id" separator=" or "/>
			</xpath>
			<xpath expr="//label[@name='bom_label']" position="attributes">
				<attribute name="invisible" add="ticket_on_hold_id" separator=" or "/>
			</xpath>
			<xpath expr="//field[@name='move_raw_ids']/tree" position="inside">
				<field name="ticket_on_hold_id" column_invisible="1"/>
			</xpath>
			<xpath expr="//field[@name='product_id']" position="attributes">
				<attribute name="readonly" add="ticket_on_hold_id" separator=" or "/>
                <attribute name="force_save">1</attribute>
			</xpath>
			<xpath expr="//field[@name='product_qty']" position="attributes">
				<attribute name="readonly" add="ticket_on_hold_id" separator=" or "/>
                <attribute name="force_save">1</attribute>
			</xpath>
			<xpath expr="//field[@name='product_uom_id'][@groups='uom.group_uom']" position="attributes">
				<attribute name="readonly" add="ticket_on_hold_id" separator=" or "/>
				<attribute name="force_save">1</attribute>
			</xpath>
        </field>
    </record>

	<record id="mrp_production_ticket_on_hold_wizard_view" model="ir.ui.view">
		<field name="name">mrp.production.ticket.on.hold.wizard.view</field>
		<field name="model">mrp.production</field>
		<field name="priority">9999</field>
		<field name="arch" type="xml">
			<form string="Ticket On Hold">
				<field name="mo_type" invisible="1"/>
				<field name="company_id" invisible="1"/>
				<field name="warehouse_id" invisible="1"/>
				<field name="ticket_on_hold_type" invisible="1"/>
				<field name="ticket_on_hold_id" invisible="1"/>
				<group class="mb-4">
					<label for="ticket_on_hold_reason" string="Reason"/>
					<field name="ticket_on_hold_reason" string="Reason" widget="text" required="1" nolabel="1" colspan="2"/>
				</group>
				<group>
					<group>
						<field name="load_id" domain="ticket_on_hold_type == 'remix' and [
								('linked_group_workcenter_ids', '=', load_station_id), ('state', '=', 'draft'),
								('product_id', '=', product_id),
								('delivery_address_id', '=', delivery_address_id)
								 ]  or [('linked_group_workcenter_ids', '=', load_station_id), ('state', '=', 'draft')]" />
						<label for="product_qty" string="Quantity"/>
						<div class="o_row">
							<field name="product_qty" class="oe_inline" readonly="1" force_save="1"/>
							<field name="product_uom_id" class="oe_inline" readonly="1" force_save="1" groups="uom.group_uom"/>
						</div>
						<field name="load_station_id"/>
						<field name="sale_order_id"/>
						<field name="product_id" readonly="1" force_save="1"/>
						<field name="bom_mix_id"/>
						<field name="mix_note"/>
						<field name="delivery_address_id"/>
					</group>
					<group>
						<field name="vehicle_id"
							readonly="ticket_on_hold_type != 'swap'"
							force_save="1"
							domain="load_station_id and [('station_id', '=', load_station_id), ('state_concrete', '=', 'available')] or [('state_concrete', '=', 'available')]"
						/>
					</group>
				</group>
				<footer>
					<button name="action_open_concrete_ticket_form" type="object" class="btn-primary">
						<span invisible="ticket_on_hold_type != 'remix'">Remix</span>
						<span invisible="ticket_on_hold_type != 'swap'">Swap</span>
						<span invisible="ticket_on_hold_type in ('remix','swap')">Save</span>
					</button>
					<button string="Discard" special="cancel" class="btn-secondary"/>
				</footer>
			</form>
		</field>
	</record>

    <record id="view_mrp_production_filter_inherit_betong" model="ir.ui.view">
        <field name="name">view_mrp_production_filter_inherit_betong</field>
        <field name="model">mrp.production</field>
		<field name="mode">primary</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
            	<field name="sale_order_id"/>
            	<field name="vehicle_station_id"/>
            	<field name="vehicle_id"/>
            	<field name="eta"/>
            	<field name="delivery_address_id"/>
            	<field name="create_date"/>
            	<field name="create_uid"/>
            	<field name="user_id"/>
            	<filter string="Draft" name="state_draft"
				        domain="[('state','=','draft')]"/>
				
				<filter string="Assigned" name="state_assigned"
				        domain="[('state','=','assigned')]"/>
				
				<filter string="Loading" name="state_loading"
				        domain="[('state','=','loading')]"/>
				
				<filter string="Loaded" name="state_loaded"
				        domain="[('state','=','loaded')]"/>
				
				<filter string="Leave" name="state_leave"
				        domain="[('state','=','leave')]"/>
				
				<filter string="Arrived" name="state_arrived"
				        domain="[('state','=','arrived')]"/>
				
				<filter string="Unloading" name="state_unloading"
				        domain="[('state','=','unloading')]"/>
				
				<filter string="Return" name="state_return"
				        domain="[('state','=','return')]"/>
				
				<filter string="Completed" name="state_completed"
				        domain="[('state','=','completed')]"/>
				
				<filter string="On Hold" name="state_on_hold"
				        domain="[('state','=','on_hold')]"/>
				
				<filter string="Dump" name="state_dump"
				        domain="[('state','=','dump')]"/>
				
				<filter string="Remix" name="state_remix"
				        domain="[('state','=','remix')]"/>

				<filter string="Swap" name="state_swap"
				        domain="[('state','=','swap')]"/>

				<filter string="Cancelled" name="state_cancel"
				        domain="[('state','=','cancel')]"/>
            </xpath>
            <xpath expr="//filter[@name='date']" position="after">
            	<filter string="Sales Order"
            			name="sale_order"
			            context="{'group_by':'sale_order_id'}"/>
			    <filter string="Station"
			    		name="plant"
			            context="{'group_by':'vehicle_station_id'}"/>
			    <filter string="Vehicle"
			    		name="vehicle"
			            context="{'group_by':'vehicle_id'}"/>
			    <filter string="Construction Site"
			    		name="construction"
			            context="{'group_by':'delivery_address_id'}"/>
			    <filter string="ETA"
			    		name="eta"
			            context="{'group_by':'eta'}"/>
            </xpath>
        </field>
    </record>

	<record id="action_concrete_ticket" model="ir.actions.act_window">
		<field name="name">Concrete Tickets</field>
		<field name="res_model">mrp.production</field>
		<field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
		<field name="view_id" eval="False"/>
		<field name="search_view_id" ref="view_mrp_production_filter_inherit_betong"/>
		<field name="context">{'default_mo_type': 'concrete', 'search_default_todo': True, 'default_company_id': allowed_company_ids[0]}</field>
		<field name="domain">[('mo_type', '=', 'concrete')]</field>
		<field name="help" type="html">
			<p class="o_view_nocontent_smiling_face">
			No concrete ticket found. Let's create one.
			</p><p>
			Use Concrete Tickets to build finished products while consuming components: i.e. 1 Table = 4 Table Legs + 1 Table Top
			</p>
		</field>
	</record>

	<record id="action_concrete_ticket_form" model="ir.actions.act_window.view">
		<field name="sequence" eval="2"/>
		<field name="view_mode">form</field>
		<field name="view_id" ref="mrp_production_form_view_inherit_max_betong_sale"/>
		<field name="act_window_id" ref="action_concrete_ticket"/>
	</record>

	<record id="action_concrete_ticket_tree" model="ir.actions.act_window.view">
		<field name="sequence" eval="1"/>
		<field name="view_mode">tree</field>
		<field name="view_id" ref="mrp_production_tree_view_inherit_max_betong_sale"/>
		<field name="act_window_id" ref="action_concrete_ticket"/>
	</record>

	<record id="action_mrp_production_form_view_form" model="ir.actions.act_window.view">
		<field name="sequence" eval="2"/>
		<field name="view_mode">form</field>
		<field name="view_id" ref="mrp.mrp_production_form_view"/>
		<field name="act_window_id" ref="mrp.mrp_production_action"/>
	</record>

	<record id="action_mrp_production_tree_view_tree" model="ir.actions.act_window.view">
		<field name="sequence" eval="1"/>
		<field name="view_mode">tree</field>
		<field name="view_id" ref="mrp.mrp_production_tree_view"/>
		<field name="act_window_id" ref="mrp.mrp_production_action"/>
	</record>


	
    <record id="mrp_production_tree_view_inherit_max_betong_sale" model="ir.ui.view">
        <field name="name">mrp.production.tree.view.inherit.max.betong.sale</field>
        <field name="model">mrp.production</field>
		<field name="mode">primary</field>
		<field name="priority">10</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view"/>
        <field name="arch" type="xml">
			<field name="state" position="attributes">
				<attribute name="column_invisible">True</attribute>
			</field> 
			<field name="state" position="after">
				<field name="state_concrete"/>
			</field> 
            <xpath expr="//field[@name='state']" position="before">
            	<field name="eta" optional="show"/>
            	<field name="load_station_id" optional="show"/>
            	<field name="vehicle_id" optional="show"/>
            	<field name="sale_order_id" optional="show"/>
            	<field name="create_date" optional="show"/>
            </xpath>
        </field>
    </record>
    
   	<record id="mrp.mrp_production_action" model="ir.actions.act_window">
        <field name="name">Ticket</field>
		<!-- <field name="domain">[('mo_type', '=', 'normal')]</field> -->
    </record>
    
    <menuitem action="mrp.mrp_production_action"
            id="mrp.menu_mrp_production_action"
            parent="mrp.menu_mrp_manufacturing"
            name="Ticket"
            sequence="1"/>

    <record id="mrp_workcenter_form_inherit_responsible" model="ir.ui.view">
	    <field name="name">mrp.workcenter.form.inherit.responsible</field>
	    <field name="model">mrp.workcenter</field>
	    <field name="inherit_id" ref="mrp.mrp_workcenter_view"/>
	    <field name="arch" type="xml">
	        <xpath expr="//group//group[2]//field[@name='company_id']" position="after">
	            <field name="warehouse_id"/>
	            <field name="responsible_id"/>
	        </xpath>
			<field name="alternative_workcenter_ids" position="after">
				<field name="linked_workcenter_id"/>
			</field>
	    </field>
	 </record>

	<record id="stock_scrap_form_view2_inherit" model="ir.ui.view">
		<field name="name">stock.scrap.form2.inherit</field>
		<field name="model">stock.scrap</field>
		<field name="inherit_id" ref="stock.stock_scrap_form_view2"/>
		<field name="arch" type="xml">
		
			<xpath expr="//field[@name='product_id']" position="after">
				<field name="is_readonly_product" invisible="1"/>
			</xpath>
			<xpath expr="//field[@name='product_id']" position="attributes">
				<attribute name="readonly" add="is_readonly_product" separator=" or "/>
				<attribute name="force_save">1</attribute>
			</xpath>

			<xpath expr="//field[@name='scrap_qty']" position="attributes">
				<attribute name="readonly" add="is_readonly_product" separator=" or "/>
				<attribute name="force_save">1</attribute>
			</xpath>

			<xpath expr="//field[@name='product_uom_id']" position="attributes">
				<attribute name="readonly" add="is_readonly_product" separator=" or "/>
				<attribute name="force_save">1</attribute>
			</xpath>
			<xpath expr="//group/group[1]" position="inside">
				<field name="dump_reason"  invisible="not is_readonly_product" required="1"/>
			</xpath>

		</field>
	</record>
    
</odoo>