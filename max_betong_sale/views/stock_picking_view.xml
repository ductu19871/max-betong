<odoo>
    <record id="view_picking_form_inherit_ticket_info" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.ticket.info</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/field[@name='state']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            
            <xpath expr="(//form/header/field[@name='state'])[2]" position="after">
                <field name="state_raw" widget="statusbar" invisible="picking_type_code != 'incoming'" statusbar_visible="draft,assigned,done" readonly="1"/>
                <field name="state_raw" widget="statusbar" invisible="picking_type_code == 'incoming'" statusbar_visible="draft,confirmed,assigned,done" readonly="1"/>
            </xpath>

            <xpath expr="(//form/header/field[@name='state'])[2]" position="attributes">
                <attribute name="invisible" add="1" separator=" or " />
            </xpath>

            <xpath expr="//field[@name='backorder_id']" position="after">
            	<field name="do_type" invisible="1"/>
            	<field name="ticket_id" invisible="do_type !='concrete'"/>
            	<field name="workcenter_id" invisible="do_type !='concrete'"/>
                <field name="vehicle_id" invisible="do_type !='concrete'"/>
                <field name="driver_id" invisible="do_type !='concrete'"/>
           </xpath>
           <xpath expr="//field[@name='date_deadline']" position="after">
            	<field name="factory_out_time" invisible="do_type !='concrete'"/>
           </xpath>
           <xpath expr="//field[@name='origin']" position="after">
           		<label for="accumulated_qty" invisible="do_type !='concrete'"/>
				<div name="accumulated_qty" invisible="do_type !='concrete'">
					<field name="accumulated_qty" class="oe_inline"/><strong> m3</strong>
				</div>
           </xpath>
        </field>
    </record>

    <record id="stock_picking_tree_concrete" model="ir.ui.view">
        <field name="name">stock.picking.tree.concrete</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="priority" eval="20"/>
        <field name="arch" type="xml">
                <xpath expr="//field[@name='state']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>
                <xpath expr="//field[@name='state']" position="after">
                    <field name="state_raw" widget="badge" decoration-danger="state=='cancel'" decoration-info="state== 'assigned'" decoration-muted="state == 'draft'" decoration-success="state == 'done'" decoration-warning="state not in ('draft','cancel','done','assigned')"/>
                </xpath>
            </field>
    </record>

    <record id="action_concrete_delivery_order" model="ir.actions.act_window">
		<field name="name">Concrete Deliveries</field>
            <field name="res_model">stock.picking</field>
            <field name="view_mode">tree,kanban,form,calendar,activity</field>
            <field name="domain">[('do_type', '=', 'concrete')]</field>
            <field name="context">{'default_do_type': 'concrete', 'contact_display': 'partner_address', 'default_company_id': allowed_company_ids[0], 'restricted_picking_type_code': 'outgoing', 'search_default_delivery': 1}</field>
            <field name="search_view_id" ref="stock.view_picking_internal_search"/>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No delivery found. Let's create one!
                </p><p>
                    Deliveries allow you to send products from your stock to a partner.
                </p>
            </field>
	</record>


</odoo>
