<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend sale.order form view -->
        <record id="sale_order_form_view_betong" model="ir.ui.view">
            <field name="name">sale.order.form.betong</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="before">
                    <field name="so_type"/>
                    <field name="trial_mix" invisible="so_type != 'betong'" readonly="has_pump"/>
                    <field name="has_pump" invisible="so_type != 'betong'" readonly="trial_mix"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="attributes">
	           		<attribute name="invisible">so_type == 'betong'</attribute>
	           </xpath>
	           <xpath expr="//field[@name='state']" position="after">
	           		<field name="state" widget="statusbar" statusbar_visible="draft,sent,sale,planned,dispatching,done" 
	           			invisible="so_type != 'betong'"/>
	           </xpath>
	           <xpath expr="//field[@name='validity_date']" position="before">
	           		<field name="concrete_station_id" invisible="so_type != 'betong'" required="so_type == 'betong'"/>
	           </xpath>
	           <xpath expr="//button[@name='action_cancel']" position="attributes">
	           		<attribute name="invisible">so_type == 'betong'</attribute>
	           </xpath>
	           <xpath expr="//button[@name='action_cancel']" position="after">
	           		<button name="action_cancel" type="object" string="Cancel" 
	           		invisible="state not in ['sale', 'planned', 'dispatching'] or not id or locked or so_type != 'betong'" data-hotkey="x"/>
	           </xpath>
	           <xpath expr="//field[@name='note']" position="before">
	                <field name="volume" widget="float" invisible="so_type != 'betong'"/>
                    <field name="volume_allocated" widget="float" invisible="so_type != 'betong'"/>
                    <field name="volume_unallocated" widget="float" invisible="so_type != 'betong'"/>
              </xpath>
			<xpath expr="//header" position="inside">
			    <button name="action_betong_set_planned" 
			            string="Planned" 
			            type="object"
			            class="oe_stat_button"
			            invisible="so_type != 'betong' or state not in ['sale']"/>
			    <button name="action_betong_set_completed" 
			            string="Completed" 
			            type="object"
			            class="oe_stat_button"
			            invisible="so_type != 'betong' or state not in ['planned','dispatching']"/>
			    />
			    <button name="action_betong_set_dispatching" 
			            string="Dispatching" 
			            type="object"
			            class="oe_stat_button"
			            invisible="so_type != 'betong' or state not in ['planned']"/>
			    />
			</xpath>
            </field>
        </record>
        
        <record id="sale_order_tree_view_betong" model="ir.ui.view">
            <field name="name">sale.order.tree.betong</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="so_type"/>
                </xpath>
            </field>
        </record>
        
        <record id="sale_order_search_view_betong" model="ir.ui.view">
            <field name="name">sale.order.search.betong</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                    <separator/>
                    <filter string="Báo Giá (Nháp)" 
                            name="draft" 
                            domain="[('state', '=', 'draft')]"/>
                    <filter string="Báo giá đã gửi" 
                            name="sent" 
                            domain="[('state', '=', 'sent')]"/>
                    <filter string="Đơn bán hàng (Đã xác nhận)" 
                            name="sale" 
                            domain="[('state', '=', 'sale')]"/>
                    <filter string="Planned" 
                            name="planned" 
                            domain="[('state', '=', 'planned')]"/>
                    <filter string="Dispatching" 
                            name="dispatching" 
                            domain="[('state', '=', 'dispatching')]"/>
                    <filter string="Completed" 
                            name="done" 
                            domain="[('state', '=', 'done')]"/>
                    <filter string="Cancelled" 
                            name="cancel" 
                            domain="[('state', '=', 'cancel')]"/>
                </xpath>
                <xpath expr="//group" position="inside">
                    <separator/>
                    <filter string="Trạng thái SO" 
                            name="group_state" 
                            context="{'group_by': 'state'}"/>
                    <filter string="Ngày Dispatching" 
                            name="group_dispatching_date" 
                            context="{'group_by': 'dispatching_date'}"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>

