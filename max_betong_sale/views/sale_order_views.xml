<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Extend sale.order form view -->
        <record id="sale_order_form_view_betong" model="ir.ui.view">
            <field name="name">sale.order.form.betong</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="before">
                    <field name="so_type" invisible="1"/>
                    <field name="trial_mix" invisible="so_type != 'concrete'" 
                    readonly="has_pump or state in ('sale','planned','dispatching','done')" force_save="1"/>
                    <field name="has_pump" invisible="so_type != 'concrete'" 
                    readonly="trial_mix or state in ('sale','planned','dispatching','done')" force_save="1"/>
                    <field name="sale_concrete_id" invisible="so_type != 'bom'"/>
                    <field name="sale_pumb_ids" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='state']" position="attributes">
	           		<attribute name="invisible">so_type == 'concrete'</attribute>
	           </xpath>
	           <xpath expr="//button[@id='create_invoice_percentage']" position="attributes">
	           		<attribute name="invisible">so_type == 'concrete' or invoice_status != 'no' or state != 'sale'</attribute>
	           </xpath>
	           <xpath expr="//field[@name='state']" position="after">
	           		<field name="state" widget="statusbar" statusbar_visible="draft,sent,sale,planned,dispatching,done" 
	           			invisible="so_type != 'concrete'"/>
	           </xpath>
	           <xpath expr="//field[@name='validity_date']" position="before">
	           		<field name="concrete_station_id" readonly="state not in ['draft', 'sent', 'sale'] and so_type == 'concrete'" invisible="so_type != 'concrete'" required="so_type == 'concrete'"/>
	           </xpath>
               <xpath expr="//field[@name='validity_date']" position="attributes">
                    <attribute name="readonly">state not in ['draft', 'sent']</attribute>
               </xpath>
               <xpath expr="//label[@for='date_order'][1]/.." position="attributes">
                    <attribute name="invisible" add="state in ['planned', 'dispatching', 'done']" separator=" or "/>
               </xpath>
               <xpath expr="//field[@name='date_order'][1]" position="attributes">
                    <attribute name="readonly">state not in ['draft', 'sent']</attribute>
                    <attribute name="invisible" add="state in ['planned', 'dispatching', 'done']" separator=" or "/>
               </xpath>
               <xpath expr="//field[@name='pricelist_id']" position="attributes">
                    <attribute name="readonly">state not in ['draft', 'sent']</attribute>
               </xpath>
               <xpath expr="//field[@name='payment_term_id']" position="attributes">
                    <attribute name="readonly">state not in ['draft', 'sent']</attribute>
               </xpath>
               <xpath expr="//field[@name='analytic_distribution']" position="attributes">
                    <attribute name="readonly">state not in ['draft', 'sent']</attribute>
               </xpath>
	           <xpath expr="//button[@name='action_cancel']" position="attributes">
	           		<attribute name="invisible">so_type == 'concrete'</attribute>
	           </xpath>
               <xpath expr="//field[@name='commitment_date']" position="attributes">
	           		<attribute name="readonly">so_type == 'concrete' and state not in ['draft', 'sent', 'sale', 'planned']</attribute>
	           </xpath>
               <xpath expr="//div[hasclass('o_row')]//field[@name='expected_date']/../../span[hasclass('text-muted')]" position="attributes">
	           		<attribute name="invisible" add="so_type == 'concrete'" separator=" or "></attribute>
	           </xpath>
	           <xpath expr="//button[@name='action_cancel']" position="after">
	           		<button name="action_cancel" type="object" string="Cancel" 
	           		invisible="state not in ['sale', 'planned', 'dispatching'] or not id or locked or so_type != 'concrete'" data-hotkey="x"/>
	           </xpath>
	           <xpath expr="//group[@name='note_group']//field[@name='note']" position="before">
	           		<label for="volume" invisible="so_type != 'concrete'"/>
					<div name="volume" invisible="so_type != 'concrete'">
						<field name="volume" class="oe_inline"/><strong> </strong><field name="product_uom" class="oe_inline"/>
					</div>
					<label for="volume_allocated" invisible="so_type != 'concrete'"/>
					<div name="volume_allocated" invisible="so_type != 'concrete'">
						<field name="volume_allocated" class="oe_inline"/><strong> </strong><field name="product_uom" class="oe_inline"/>
					</div>
					<label for="volume_unallocated" invisible="so_type != 'concrete'"/>
					<div name="volume_unallocated" invisible="so_type != 'concrete'">
						<field name="volume_unallocated" class="oe_inline"/><strong> </strong><field name="product_uom" class="oe_inline"/>
					</div>
              </xpath>
			<xpath expr="//header" position="inside">
			    <button name="action_betong_set_planned" 
			            string="Planned" 
			            type="object"
			            class="oe_stat_button"
			            invisible="so_type != 'concrete' or state not in ['sale']"/>
			    <button name="action_betong_set_completed" 
			            string="Completed" 
			            type="object"
			            class="oe_stat_button"
			            invisible="so_type != 'concrete' or state not in ['planned','dispatching']"/>
			    />
			    <button name="action_betong_set_dispatching" 
			            string="Dispatching" 
			            type="object"
			            class="oe_stat_button"
			            invisible="so_type != 'concrete' or state not in ['planned']"/>
			    />
			    <button
					    name="action_split_load"
					    type="object"
					    string="Split Load"
				    	class="oe_highlight"
				    	invisible="so_type != 'concrete' or state not in ['planned','dispatching'] or volume_unallocated &lt;= 0"
				/>
			</xpath>
			<div name="button_box" position="inside">
				 <button name="action_view_load" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="count_load == 0">
                    <field name="count_load" widget="statinfo" string="Loads"/>
                </button>
                <button name="action_view_so_pumb" 
                	type="object" class="oe_stat_button" 
                	icon="fa-pencil-square-o"
                	string="SO Pumb"
                	invisible="not has_pump or not sale_pumb_ids">
                </button>
                <button name="action_view_so_origin" 
	                type="object" 
	                class="oe_stat_button" 
	                icon="fa-pencil-square-o" 
	                string="SO Concrete"
	                invisible="so_type != 'bom' or not sale_concrete_id">
                </button>
			 </div>
			 <xpath expr="//field[@name='order_line']//tree//field[@name='qty_delivered']" position="attributes">
	           		<attribute name="column_invisible">(parent.state not in ('planned','dispatching','done') and parent.so_type =='concrete') or (parent.state !='sale' and parent.so_type !='concrete')</attribute>
             </xpath>
             <xpath expr="//field[@name='order_line']//tree//field[@name='qty_invoiced']" position="attributes">
	           		<attribute name="column_invisible">(parent.state not in ('planned','dispatching','done') and parent.so_type =='concrete') or (parent.state !='sale' and parent.so_type !='concrete')</attribute>
             </xpath>
			 <xpath expr="//field[@name='order_line']//tree//field[@name='product_template_id']" position="attributes">
	           		<attribute name="column_invisible">parent.so_type == 'concrete'</attribute>
             </xpath>
             <xpath expr="//field[@name='order_line']//tree//field[@name='product_template_id']" position="after">
             	<field name="product_template_id"
                        string="Product"
                        class="product_beton"
                        column_invisible="parent.so_type != 'concrete'"
                        readonly="not product_updatable"
                        required="not display_type"
                        context="{
                            'partner_id': parent.partner_id,
                            'quantity': product_uom_qty,
                            'pricelist': parent.pricelist_id,
                            'uom':product_uom,
                            'company_id': parent.company_id,
                            'default_list_price': price_unit,
                            'default_description_sale': name
                        }"
                        options="{
                            'no_open': True,
                        }"
                        domain="[('sale_ok', '=', True),('is_concrete_product','=',True)]"
                        widget="sol_product_many2one"
                        placeholder="Type to find a product..."/>
             </xpath>
             <group name="partner_details" position="inside">
				 <field name="bom_id" invisible="so_type != 'concrete'"/>
				 <field name="mix_note" invisible="so_type != 'concrete'"/>
			 </group>
            </field>
        </record>

        <record id="blanket_order_view_order_form_betong" model="ir.ui.view">
            <field name="name">blanket.sale.order.form.betong</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale_blanket_order.view_order_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='blanket_order_line']" position="attributes">
                        <attribute name="domain">[('order_id', '=', parent.blanket_order_id)]</attribute>
                        <attribute name="readonly">parent.so_type == 'concrete' and parent.state not in ['draft', 'sent', 'sale']</attribute>
                    </xpath>
                    <xpath expr="//field[@name='partner_id']" position="before">
                        <field name="blanket_order_id" readonly="1" invisible="not blanket_order_id" />
                    </xpath>
                    <!-- <xpath expr="//field[@class='product_beton']" position="attributes">
                        <attribute name="readonly">not product_updatable or blanket_order_line</attribute>
                    </xpath> -->
                    <xpath expr="//field[@name='partner_id']" position="attributes">
                        <attribute name="readonly">state in ['cancel', 'sale'] or (blanket_order_id and so_type == 'concrete')</attribute>
                    </xpath>
                    <xpath expr="//field[@name='partner_invoice_id']" position="attributes">
                        <attribute name="readonly">state == 'cancel' or locked or (blanket_order_id and so_type == 'concrete')</attribute>
                    </xpath>
                </data>
            </field>
        </record>
        
        <record id="sale_order_tree_view_betong" model="ir.ui.view">
            <field name="name">sale.order.tree.betong</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="so_type"/>
                </xpath>
            </field>
        </record>
        
        <record id="sale_order_search_view_betong" model="ir.ui.view">
            <field name="name">sale.order.search.betong</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_sales_order_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                    <separator/>
                    <filter string="Draft" 
                            name="draft" 
                            domain="[('state', '=', 'draft')]"/>
                    <filter string="Send" 
                            name="sent" 
                            domain="[('state', '=', 'sent')]"/>
                    <filter string="Sale" 
                            name="sale" 
                            domain="[('state', '=', 'sale')]"/>
                    <filter string="Planned" 
                            name="planned" 
                            domain="[('state', '=', 'planned')]"/>
                    <filter string="Dispatching" 
                            name="dispatching" 
                            domain="[('state', '=', 'dispatching')]"/>
                    <filter string="Completed" 
                            name="done" 
                            domain="[('state', '=', 'done')]"/>
                    <filter string="Cancelled" 
                            name="cancel" 
                            domain="[('state', '=', 'cancel')]"/>
                </xpath>
                <xpath expr="//group" position="inside">
                    <separator/>
                    <filter string="State" 
                            name="group_state" 
                            context="{'group_by': 'state'}"/>
                    <filter string="Date Dispatching" 
                            name="group_dispatching_date" 
                            context="{'group_by': 'dispatching_date'}"/>
                </xpath>
            </field>
        </record>


        <record id="sale.action_quotations" model="ir.actions.act_window">
            <field name="context">{'default_so_type':'normal', 'search_default_my_quotation': 1}</field>
            <field name="domain">[('so_type','=','normal')]</field>
        </record>

        <record model="ir.actions.act_window" id="sale.action_orders">
            <field name="context">{'default_so_type':'normal', 'search_default_my_sale_orders': 1}</field>
            <field name="domain">[('so_type','=','normal'),('state', 'not in', ('draft', 'sent', 'cancel'))]</field>
        </record>

        <record id="action_concrete_orders" model="ir.actions.act_window">
            <field name="name">Concrete Orders</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
            <field name="search_view_id" ref="sale.sale_order_view_search_inherit_sale"/>
            <field name="context">{'search_default_my_sale_orders': 1, 'default_so_type':'concrete'}</field>
            <field name="domain">[('so_type', '=', 'concrete')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new concrete quotation, the first step of a new sale!
                </p><p>
                    Once the concrete quotation is confirmed, it becomes a concrete order.<br/> You will be able to create an invoice and collect the payment.
                </p>
            </field>
        </record>

        <record id="action_pumb_orders" model="ir.actions.act_window">
            <field name="name">Pumb Orders</field>
            <field name="res_model">sale.order</field>
            <field name="view_mode">tree,kanban,form,calendar,pivot,graph,activity</field>
            <field name="search_view_id" ref="sale.sale_order_view_search_inherit_sale"/>
            <field name="context">{'search_default_my_sale_orders': 1, 'default_so_type':'bom'}</field>
            <field name="domain">[('so_type', '=', 'bom')]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new pumb quotation, the first step of a new sale!
                </p><p>
                    Once the pumb quotation is confirmed, it becomes a pumb order.<br/> You will be able to create an invoice and collect the payment.
                </p>
            </field>
        </record>

    </data>
</odoo>

