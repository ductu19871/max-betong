<odoo>
    <record id="concrete_lifetime_report_tree_view" model="ir.ui.view">
        <field name="name">concrete.lifetime.report.tree.view</field>
        <field name="model">mrp.production</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="trip_per_trunk_report_tree_view"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-warning">
                lifetime_minutes &gt; concrete_lifespan
                </attribute>
                <attribute name="decoration-success">
                lifetime_minutes &lt;= concrete_lifespan
                </attribute>
            </xpath>
            <xpath expr="//tree/field[@name='state_concrete']" position="replace">
            </xpath>
            <xpath expr="//tree/field[@name='product_qty']" position="after">
                <field name="loaded_datetime"/>
                <field name="return_state_tracking_datetime"/>
                <field name="lifetime_minutes" avg="Average Lifetime (minutes)"/>
                <field name="concrete_lifespan" column_invisible="True"/>
            </xpath>
        </field>
    </record>

    <record id="action_concrete_lifetime_report" model="ir.actions.act_window">
        <field name="name">Concrete Lifetime Report</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="concrete_lifetime_report_tree_view"/>
        <field name="search_view_id" ref="view_concrete_ticket_report_search"/>
        <field name="domain">[('state_concrete', '=', 'completed')]</field>
        <field name="context">{'concrete_lifetime_report': True}</field>
    </record>

    <menuitem id="menu_concrete_lifetime_report" parent="menu_concrete_coordination_report" action="action_concrete_lifetime_report" sequence="50"/>
</odoo>
