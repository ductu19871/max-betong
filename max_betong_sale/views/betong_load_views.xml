<?xml version="1.0" encoding="utf-8"?>
<odoo>
	
    <record id="view_concrete_load_tree" model="ir.ui.view">
        <field name="name">concrete.load.tree</field>
        <field name="model">concrete.load</field>
        <field name="arch" type="xml">
            <tree string="Concrete Load" default_order="create_date desc">
                <field name="name"/>
                <field name="volume"/>
                <field name="load_station_id"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="bom_id"/>
                <field name="mix_note"/>
                <field name="delivery_address_id"/>
                <field name="vehicle_id"/>
                <field name="vehicle_station_id"/>
                <field name="state"/>
                <field name="create_date"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_concrete_load_form" model="ir.ui.view">
        <field name="name">concrete.load.form</field>
        <field name="model">concrete.load</field>
        <field name="arch" type="xml">
            <form string="Load">
				<header>
                    <button string="Assign Ticket" 
                            type="action" 
                            name="%(action_wizard_confirm_fields)d"
                            invisible="state in ('completed', 'cancelled')"
                            context="{'default_vehicle_station_id': load_station_id}"
                            groups="max_betong_sale.group_betong_load_manager"/>


                    <!--<button string="Set to Draft" type="object" name="action_set_draft"
                            invisible="state =='draft'"/>-->
                    <button
				        name="%(action_wizard_confirm_fields_station_volumn)d"
				        string="Load Station"
				        type="action"
                        context="{'default_volume': volume}"
				        class="oe_highlight"
				        invisible="state in ('completed', 'cancelled')"
				    />
                    <field name="state" widget="statusbar" statusbar_visible="draft,completed,cancelled"/>
                </header>
                <sheet>
					<div name="button_box" >
		                <button name="action_view_ticket" 
		                	type="object" class="oe_stat_button" 
		                	icon="fa-pencil-square-o"
		                	string="Tickets"
		                	invisible="not production_ids">
		                </button>
					 </div>
					<div class="oe_title">
						<label for="name"/>
                        <h1>
                            <field name="name" placeholder="Load Code"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Information Load">
                            <field name="volume" readonly="1"/>
                            <field name="load_station_id" readonly="1"/>
                            <field name="sale_order_id"/>
                            <field name="product_id"/>
                            <field name="bom_id"/>
                            <field name="mix_note"/>
                            <field name="delivery_address_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="production_ids" invisible="1"/>
                            <field name="bom_id" invisible="1"/>
                        </group>
                        <group string="Information Vehicle">
                            <field name="vehicle_id" readonly="1"/>
                            <field name="vehicle_station_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_concrete_load_search" model="ir.ui.view">
        <field name="name">concrete.load.search</field>
        <field name="model">concrete.load</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="volume"/>
                <field name="load_station_id"/>
                <field name="sale_order_id"/>
                <field name="product_id"/>
                <field name="delivery_address_id"/>
                <field name="vehicle_id"/>
                <field name="vehicle_station_id"/>
                <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="Completed" name="filter_completed" domain="[('state','=','completed')]"/>
                <filter string="Cancelled" name="filter_cancelled" domain="[('state','=','cancelled')]"/>
                <group expand="0" string="Group By">
					<filter name="groupby_sale_order_id" string="Sale order" context="{'group_by': 'sale_order_id'}"/>
					<filter name="groupby_load_station_id" string="Load Station" context="{'group_by': 'load_station_id'}"/>
					<filter name="groupby_product_id" string="Product" context="{'group_by': 'product_id'}"/>
					<filter name="groupby_delivery_address_id" string="Delivery Address" context="{'group_by': 'delivery_address_id'}"/>
					<filter name="groupby_state" string="State" context="{'group_by': 'state'}"/>
					<filter name="groupby_create_date" string="Create Date" context="{'group_by': 'create_date'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <record id="action_concrete_load" model="ir.actions.act_window">
        <field name="name">Concrete Load</field>
        <field name="res_model">concrete.load</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_filter_draft':1}</field>
        <field name="search_view_id" ref="view_concrete_load_search"/>
    </record>
    
</odoo>