<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="product_template_concrete_action" model="ir.actions.act_window">
            <field name="name">Concrete Template Products</field>
            <field name="res_model">product.template</field>
            <field name="view_mode">tree,kanban,form,pivot,graph,activity</field>
            <field name="search_view_id" ref="product.product_template_search_view"/>
            <field name="context">{'default_is_concrete_product': 1}</field>
            <field name="domain">[('is_concrete_product', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new concrete template product, the first step of a new product!
                </p>
            </field>
        </record>   

        <record id="product_concrete_product_action" model="ir.actions.act_window">
            <field name="name">Concrete Products</field>
            <field name="res_model">product.product</field>
            <field name="view_mode">tree,kanban,form,pivot,graph,activity</field>
            <field name="search_view_id" ref="product.product_search_form_view"/>
            <field name="context">{'default_is_concrete_product': 1}</field>
            <field name="domain">[('is_concrete_product', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new concrete product, the first step of a new product!
                </p>
            </field>
        </record>

        <record id="product_concrete_bill_of_material_action" model="ir.actions.act_window">
            <field name="name">Concrete Bill of Material</field>
            <field name="res_model">mrp.bom</field>
            <field name="view_mode">tree,kanban,form</field>
            <field name="domain">['|',('product_id.is_concrete_product', '=', True), ('product_tmpl_id.is_concrete_product', '=', True)]</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new concrete bill of material, the first step of a new product!
                </p>
            </field>
        </record>

    </data>
</odoo>