<odoo>
    <record id="delivered_volume_report_tree_view" model="ir.ui.view">
        <field name="name">delivered.volume.report.tree.view</field>
        <field name="model">mrp.production</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <tree string="Delivered Volume Report" create="false" js_class="clickable_list_renderer">
                <!-- Thời gian đến công trường -->
                <field name="arrived_state_tracking_datetime" string="Site Arrival Time"/>
                <!-- SO -->
                <field name="sale_order_id" options="{'no_open': False}" widget="many2one"/>
                <!-- Load -->
                <field name="load_id"/>
                <!-- Ticket -->
                <field name="name" string="Ticket"/>
                <!-- Khách hàng -->
                <field name="partner_id"/>
                <!-- Công trường -->
                <field name="delivery_address_id" string="Construction site"/>
                <!-- Trạm -->
                <field name="load_station_id" string="Station"/>
                <!-- Xe -->
                <field name="vehicle_id" string="Vehicle"/>
                <!-- Tài xế -->
                <field name="driver_id"/>
                <!-- Batcher -->
                <field name="user_id" string="Batcher"/>
                <!-- Sản phẩm -->
                <field name="product_id"/>
                <!-- Cấp phối -->
                <field name="load_bom_id"/>
                <!-- Cấp phối -->
                <field name="product_qty" string="Volume (m³)" sum="Total Volume"/>
                <!-- Ghi chú -->
                <field name="ticket_note" string="Note"/>
            </tree>
        </field>
    </record>

    <record id="view_concrete_ticket_report_search" model="ir.ui.view">
        <field name="name">concrete.ticket.report.search</field>
        <field name="model">mrp.production</field>
        <field name="arch" type="xml">
            <search string="Search Concrete Ticket">
                <field name="completed_state_tracking_datetime" invisible="not context.get('delivered_volume_report') and not context.get('on_time_delivery_report')" />
                <field name="incident_datetime"  invisible="not context.get('rejected_volume_report')"/>
                <field name="load_station_id"/>


                <field name="sale_order_id" string="SO"/>
                <field name="name" string="Ticket"/>
                <field name="load_id" string="Load"/>
                <field name="vehicle_id" string="Vehicle"/>
                <field name="driver_id" string="Driver"/>
                <field name="partner_id"/>
                <field name="delivery_address_id" string="Construction site"/>
                <field name="product_id"/>
                <field name="load_bom_id"/>
                <field name="on_hold_reason" invisible="not context.get('rejected_volume_report')"/>

                <separator/>
                <filter string="Today" name="today" domain="[
                        ('completed_state_tracking_datetime', '&gt;=', context_today()),
                        ('completed_state_tracking_datetime', '&lt;',  context_today() + relativedelta(days=1))
                    ]"/>

                <filter string="This Week" name="this_week" domain="[
                        ('completed_state_tracking_datetime', '&gt;=', context_today() + relativedelta(weekday=0)),
                        ('completed_state_tracking_datetime', '&lt;',  context_today() + relativedelta(weekday=0, weeks=1))
                    ]"/>

                <filter string="This Month" name="this_month" domain="[
                        ('completed_state_tracking_datetime', '&gt;=', context_today() + relativedelta(day=1)),
                        ('completed_state_tracking_datetime', '&lt;',  context_today() + relativedelta(day=1, months=1))
                    ]"/>

                <filter string="This Quarter" name="this_quarter" domain="[
                        ('completed_state_tracking_datetime', '&gt;=',
                            context_today() + relativedelta( month=((context_today().month - 1) // 3) * 3 + 1, day=1
                            )
                        ),
                        ('completed_state_tracking_datetime', '&lt;',
                            context_today() + relativedelta( month=((context_today().month - 1) // 3) * 3 + 4, day=1
                            )
                        )
                    ]"/>

                <filter string="This Year" name="this_year" domain="[
                        ('completed_state_tracking_datetime', '&gt;=', context_today() + relativedelta(month=1, day=1)),
                        ('completed_state_tracking_datetime', '&lt;',  context_today() + relativedelta(years=1, month=1, day=1))
                    ]"/>

                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_so" string="SO" context="{'group_by': 'sale_order_id'}"/>

                    <filter name="group_by_customer" context="{'group_by': 'partner_id'}"/>

                    <filter name="group_by_site" string="   " context="{'group_by': 'delivery_address_id'}"/>

                    <filter name="group_by_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>

                    <filter name="group_by_driver" string="Driver" context="{'group_by': 'driver_id'}"/>

                    <filter name="group_by_station" string="Station" context="{'group_by': 'load_station_id'}"/>

                    <filter name="group_by_product"  context="{'group_by': 'product_id'}"/>

                    <filter name="group_by_load_bom" context="{'group_by': 'load_bom_id'}"/>

                    <!-- <filter name="group_by_arrived_state_tracking_datetime" string="Site Arrival Time" context="{'group_by': 'arrived_state_tracking_datetime'}" invisible="not context.get('delivered_volume_report')"/>-->

                    <filter name="group_by_completed_state_tracking_datetime" context="{'group_by': 'completed_state_tracking_datetime'}" invisible="not context.get('delivered_volume_report') and not context.get('on_time_delivery_report')"/>

                    <filter name="group_by_incident_datetime" context="{'group_by': 'incident_datetime'}" invisible="not context.get('rejected_volume_report')"/>
                </group>

            </search>
        </field>
    </record>


    <record id="action_delivered_volume_report" model="ir.actions.act_window">
        <field name="name">Delivered Volume Report</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="delivered_volume_report_tree_view"/>
        <field name="search_view_id" ref="view_concrete_ticket_report_search"/>
        <field name="domain">[('state_concrete', '=', 'completed')]</field>
        <field name="context">{'delivered_volume_report':True}</field>
    </record>

    <menuitem id="menu_concrete_coordination_report" name="Report" parent="menu_concrete_coordination_root" sequence="90"/>

    <menuitem id="menu_delivered_volume_reportreport" parent="menu_concrete_coordination_report" action="action_delivered_volume_report" sequence="20"/>
</odoo>
