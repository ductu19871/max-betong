<odoo>
    <record id="cycle_time_report_tree_view" model="ir.ui.view">
        <field name="name">cycle.time.report.tree.view</field>
        <field name="model">mrp.production</field>
        <field name="priority">100</field>
        <field name="inherit_id" ref="delivered_volume_report_tree_view"/>
        <field name="mode">primary</field>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='arrived_state_tracking_datetime']" position="replace">
                <field name="completed_state_tracking_datetime" string="Trip Completion time"/>
            </xpath>
            <xpath expr="//tree/field[@name='driver_id']" position="after">
                <field name="waiting_at_plant_minutes"/>
                <field name="trip_cycle_time_minutes"/>
                <field name="full_cycle_time_minutes"/>
            </xpath>
            <field name="user_id" position="replace"/>
            <field name="product_id" position="replace"/>
            <field name="load_bom_id" position="replace"/>
            <field name="product_qty" position="replace"/>
        </field>
    </record>

    <record id="action_cycle_time_report" model="ir.actions.act_window">
        <field name="name">Cycle Time Report</field>
        <field name="res_model">mrp.production</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="cycle_time_report_tree_view"/>
        <field name="search_view_id" ref="view_concrete_ticket_report_search"/>
        <field name="domain">[('state_concrete', '=', 'completed')]</field>
        <field name="context">{'cycle_time_report': True}</field>
    </record>

    <menuitem id="menu_cycle_time_report" parent="menu_concrete_coordination_report" action="action_cycle_time_report" sequence="40"/>
</odoo>
