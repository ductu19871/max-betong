<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.actions.act_window" id="sale_blanket_order.act_open_blanket_order_view">
            <field name="context">{'default_so_type':'normal'}</field>
            <field name="domain">[('so_type','=','normal')]</field>
        </record>

        <record model="ir.actions.act_window" id="action_sale_blanket_concrete_order">
            <field name="name">Concrete Blanket Order</field>    
            <field name="res_model">sale.blanket.order</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'default_so_type':'concrete'}</field>
            <field name="domain">[('so_type','=','concrete')]</field>
            <field name="search_view_id" ref="sale_blanket_order.view_blanket_order_search" />
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Click to create a concrete blanket order that can be converted into a sale order.
                </p>
                <p>
                    Use this menu to search within your concrete blanket orders. For each concrete blanket order,
                    you can track the related discussion with the customer, control
                    the products delivered and control the vendor bills.
                </p>
            </field>
        </record>

        <record id="view_blanket_order_form_beton" model="ir.ui.view">
            <field name="name">sale.blanket.order.form.betong</field>
            <field name="model">sale.blanket.order</field>
            <field name="inherit_id" ref="sale_blanket_order.view_blanket_order_form"/>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//field[@name='partner_id']" position="after">
                        <field name="so_type" invisible="1" />
                    </xpath>
                    <xpath expr="//field[@name='line_ids']//tree//field[@name='product_id']" position="attributes">
                        <attribute name="column_invisible">parent.so_type == 'concrete'</attribute>
                    </xpath>

                    <xpath expr="//field[@name='line_ids']//tree//field[@name='product_id']" position="after">  
                        <field
                            name="product_id"
                            required="not display_type"
                            column_invisible="parent.so_type != 'concrete'"
                            domain="[('sale_ok', '=', True),('is_concrete_product','=',True)]"
                            invisible="display_type"
                            context="{
                                'fld': 'product_id',
                                'partner_id': parent.partner_id,
                                'quantity': original_uom_qty,
                                'company_id': parent.company_id
                            }"
                        />
                    </xpath>
                </data>
            </field>
        </record>
        
    </data>
</odoo>