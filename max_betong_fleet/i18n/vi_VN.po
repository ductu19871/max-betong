#. module: max_betong_fleet
#: model:ir.model.fields,help:max_betong_fleet.field_fleet_vehicle__station_id
msgid ""
"The station to which the vehicle belongs.\n"
"Used to determine the batching plant when the vehicle participates in concrete delivery."
msgstr ""
"Trạm mà xe trực thuộc.\n"
"Dùng để xác định trạm trộn khi xe tham gia giao bê tông."

