<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_fleet_vehicle_form_inherit_max_betong_fleet" model="ir.ui.view">
		    <field name="name">fleet.vehicle.form.inherit.max.betong.fleet</field>
		    <field name="model">fleet.vehicle</field>
		    <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
		    <field name="arch" type="xml">
		        <xpath expr="//label[@for='tag_ids']" position="before">
		        	<group>
                    	<field name="vehicle_type" class="oe_inline"/>
                    </group>
		        </xpath>
		        <xpath expr="//field[@name='location']" position="after">
                	<field name="station_id" invisible="vehicle_type not in ('concrete','pump')" required="vehicle_type in ('concrete','pump')"/>
		        </xpath>
		        <xpath expr="//field[@name='image_128']" position="before">
					<field name="state_concrete" widget="selection_state_badge" class="oe_avatar" readonly="1"/>
		        </xpath>
		        <xpath expr="//header" position="inside">
		        	<button string="Update State" 
		        		class="btn btn-primary"
		        		type="action" name="%(max_betong_fleet.action_wizard_change_state)d"/>
		        </xpath>
		    </field>
		</record>
    </data>
</odoo>

