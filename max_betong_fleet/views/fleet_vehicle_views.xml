<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_fleet_vehicle_form_inherit_max_betong_fleet" model="ir.ui.view">
		    <field name="name">fleet.vehicle.form.inherit.max.betong.fleet</field>
		    <field name="model">fleet.vehicle</field>
		    <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
		    <field name="arch" type="xml">
		        <xpath expr="//label[@for='tag_ids']" position="before">
		        	<group>
                    	<field name="type" class="oe_inline"/>
                    </group>
		        </xpath>
		        <xpath expr="//field[@name='location']" position="after">
                	<field name="station_id" invisible="type == 'normal'" required="type != 'normal'"/>
		        </xpath>
		    </field>
		</record>
    </data>
</odoo>

