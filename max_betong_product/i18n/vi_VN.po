#. module: max_betong_product
#: model:ir.model.fields,help:max_betong_product.field_product_product__is_concrete_product
#: model:ir.model.fields,help:max_betong_product.field_product_template__is_concrete_product
msgid ""
"Mark if this product is Concrete, managed separately according to Concrete "
"product business."
msgstr ""
"Đánh dấu nếu sản phẩm này là Bê tông, quản lý riêng theo nghiệp vụ sản phẩm "
"Bê tông."

#. module: max_betong_product
#: model:ir.model,name:max_betong_product.model_product_template
msgid "Product"
msgstr "Sản phẩm"

#. module: max_betong_product
#: model:ir.model.fields,help:max_betong_product.field_product_product__concrete_lifespan
#: model:ir.model.fields,help:max_betong_product.field_product_template__concrete_lifespan
msgid ""
"Time concrete can be used after mixing (in minutes). Used for quality "
"control and delivery coordination. If transport or waiting time exceeds "
"this value, concrete quality is not guaranteed."
msgstr ""
"Thời gian bê tông có thể sử dụng sau khi trộn (tính bằng phút)\n"
"Dùng để kiểm soát chất lượng và điều phối giao hàng.\n"
"Nếu thời gian vận chuyển hoặc chờ đổ vượt quá giá trị này, bê tông sẽ không "
"đảm bảo."

#. module: max_betong_product
#: model:ir.model.constraint,message:max_betong_product.constraint_product_template_unique_concrete_product_name
msgid "Concrete product name must be unique. Another product with the same name already exists."
msgstr "Tên sản phẩm bê tông phải là duy nhất. Đã tồn tại sản phẩm khác có cùng tên."

#. module: max_betong_product
#: model:product.template,validation_error:max_betong_product.product_template__check_unique_concrete_product_name
msgid "Concrete product name must be unique. Another product with the same name already exists."
msgstr "Tên sản phẩm bê tông phải là duy nhất. Đã tồn tại sản phẩm khác có cùng tên."